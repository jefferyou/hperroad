{
    "dataset": "HRNR",
    "gpu": false,
    "hidden_dims": 224,
    "node_dims": 128,
    "node_num": 38030,
    "cmt_num": 200,
    "cmt_dims": 256,
    "struct_cmt_num": 300,
    "struct_cmt_dims": 224,
    "fnc_cmt_num": 30,
    "fnc_cmt_dims": 256,
    "label_num": 2,
    "train_time_set": "train_time_set_eta",
    "adj": "CompleteAllGraph",
    "node_features": "node_features",
    "label_train_set": "label_pred_train_set",
    "label_train_set_false": "label_pred_train_set_false",

    "struct_assign": "struct_assign",
    "fnc_assign": "fnc_assign_dst",

    "gru_dims": 512,
    "gru_layers": 1,
    "is_bigru": "True",
    "state_num": 2,
    "vocab_size": 16000,
    "batch_size": 64,
    "device": "cuda",
    "use_cn_gnn": "False",
    "gnn_layers": 1,
    "eta_epoch": 20,
    "gae_epoch": 1000,
    "eta_learning_rate": 1e-4,
    "gae_learning_rate": 5e-4,
    "g2s_learning_rate": 1e-4,
    "g2t_learning_rate": 1e-4,
    "lp_learning_rate": 1e-4,
    "label_pred_gnn_layer": 2,

    "alpha": 0.2,
    "dropout": 0.6,

    "lane_num": 10,
    "length_num": 2560,
    "type_num": 20,
    "lane_dims": 32,
    "length_dims": 32,
    "type_dims": 32,

    "clip": 0.1,
    "g2s_clip": 1.0,
    "g2t_clip": 1.0,
    "lp_clip": 1.0,

    "g2t_sample_num": 2000,
    "g2t_epoch": 1000,
    "label_epoch": 20,

    "baseline_gat_layer": 1,
    "evaluate_tasks":["tsi", "tte", "sts"],
    "evaluate_models":["SpeedInferenceModel", "TravelTimeEstimationModel", "SimilaritySearchModel"],
    "task_epoch": 10,

    "_comment": "=== Hyperbolic-specific parameters ===",
    "hyperbolic_dim": 224,
    "lambda_ce": 0.1,
    "lambda_cc": 0.1,
    "temperature": 0.07,
    "curvature": 1.0,
    "max_epoch": 100,

    "_comment_seq": "=== Sequence branch (step 1: forward wiring) ===",
    "use_sequence_branch": true,
    "min_len": 10,
    "max_len": 128,
    "traj_batch_size": 64,
    "traj_n_layers": 2,
    "traj_n_heads": 4,
    "traj_dropout": 0.1,

    "_comment_seq_tasks": "=== Sequence branch (step 2: MTR / TCL / align) ===",
    "lambda_mtr": 0.1,
    "lambda_tcl": 0.1,
    "lambda_align": 0.1,
    "mtr_mask_ratio": 0.15,
    "mtr_neg_samples": 512,
    "align_samples": 500,
    "align_neg_samples": 64,

    "_comment_step4": "=== Step 4: multi-curvature + cross-view gate ===",
    "init_log_k": 0.5413,
    "xview_gate_hidden": 64,
    "xview_gate_reg": 0.01,

    "_comment_phase1": "=== Phase 1: STS MR long-tail fix ===",
    "use_momentum_queue": true,
    "queue_size": 8192,
    "queue_enqueue_size": 256,
    "hard_neg_ratio": 0.5,
    "contrast_neg_samples": 256,
    "queue_warmup_steps": 50,
    "lambda_rank": 0.05,
    "triplet_margin_base": 0.2,
    "tau_min": 0.03,
    "use_adaptive_tau": true,
    "rank_sample_pairs": 256,
    "rank_neg_samples": 1024,

    "_comment_phase2": "=== Phase 2: TTE RMSE tail fix ===",
    "lambda_tte_aux": 0.05,
    "lambda_tt_robust": 0.05,
    "lambda_time_var": 0.03,
    "use_step_emb": true,
    "n_step_buckets": 16,
    "huber_delta_ratio": 0.5,

    "_comment_phase3": "=== Phase 3: trajectory memory + multi-level readout ===",
    "use_traj_memory": true,
    "traj_memory_momentum": 0.99,
    "use_multi_level_readout": true,
    "readout_alpha_init": 0.2,
    "readout_beta_init": 0.1,
    "readout_gamma_init": 0.2,

    "_comment_phase4": "=== Phase 4: training strategy refinement ===",
    "curvature_warmup_epochs": 20,
    "curvature_init": 0.1,
    "log_k_lr_mult": 0.1,
    "hyp_grad_clip": 1.0,
    "use_loss_schedule": true,
    "loss_stage1_epochs": 30,
    "loss_stage2_epochs": 70
}
